{
  "name": "@geociteops/mcp",
  "version": "0.1.0",
  "mcpName": "io.github.letheliu/geociteops",
  "description": "MCP server for GeoCiteOps — GEO health checks, agent readiness, citations, content optimization, schema, llms.txt, and knowledge graph inside Claude Code, Cursor, and other MCP clients.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "geociteops-mcp": "dist/cli.js"
  },
  "main": "./dist/cli.js",
  "exports": {
    ".": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "tsc -p tsconfig.json --noEmit && node build.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/letheliu/geociteops.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/letheliu/geociteops/tree/main/mcp",
  "keywords": [
    "mcp",
    "geo",
    "generative-engine-optimization",
    "llm-seo",
    "ai-search",
    "claude",
    "cursor"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@trpc/client": "^10.45.0",
    "@trpc/server": "^10.45.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0"
  }
}

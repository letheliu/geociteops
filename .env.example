# =============================================================================
# geociteops 环境变量
#
# 两种用法：
#   1) docker compose 一键部署（推荐）：cp .env.example .env，改下面标【必改】的两项
#      → docker compose up -d → http://localhost:5170/login
#   2) 本机 pnpm 开发：.env 里 DATABASE_URL 指向你自己起的 Postgres
#      → pnpm dev:web / pnpm dev
#
# ⚠️ 【必改】两项（不改则起不来）：
#   CREDENTIAL_MASTER_KEY —— 信封加密主密钥，缺失/格式错直接启动终止
#   PAY_MOCK_SECRET       —— mock 支付回调验签密钥，缺失即 fail-closed 启动终止
#                            (src/server.ts:109 assertMockChannelConfigured)
#   两项都用同一条命令生成：
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================

# ---------- 【docker compose】Postgres ----------
# compose 内部通过服务名 db 连库，上面 compose 的 DATABASE_URL 会覆盖本项；
# 这里的值用于本机 pnpm 开发与 psql 直连。宿主机上已有 Postgres 占用 5432 时，
# 把 URL 里的端口改掉即可（compose 不向宿主机发布 5432，不会冲突）。
POSTGRES_USER=geo
POSTGRES_PASSWORD=geo_secret
POSTGRES_DB=geo

# 前端暴露端口（compose web 服务映射到宿主机该端口）
WEB_PORT=5170

# 数据库
# 本机开发示例：postgresql://geo:geo_secret@localhost:5432/geo?schema=public
DATABASE_URL="postgresql://username:password@host:port/database?schema=public"

# 服务
PORT=4000

# LLM（内部任务用，如 query 生成）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigapi.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
CHAT_MODEL=glm-4-flash

# 向量检索（Zvec 进程内向量库）
# embedding-3 为 1024 维；若改用 text-embedding-3-small(1536维) 须同步调整 ZVEC_DIM 并重建 collection
# compose 部署时这两个路径已挂命名卷（容器重建向量库不丢），无需改。
ZVEC_DATA_PATH=./data/zvec
ZVEC_DIM=1024
# 实体消歧/聚类用相似度阈值（0~1，越大越严格）
VECTOR_SIMILARITY_THRESHOLD=0.85

# 国内 AI 平台凭证（用于引用监测）
# DeepSeek
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 豆包（火山引擎）
DOUBAO_API_KEY=xxx
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-pro-4k

# 通义千问（阿里云）
QWEN_API_KEY=sk-xxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo

# 文心一言（百度）
ERNIE_API_KEY=xxx
ERNIE_SECRET_KEY=xxx
ERNIE_MODEL=ernie-speed-128k

# 国外 AI 平台凭证（用于引用监测）
# Perplexity
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# ChatGPT Search（复用 OpenAI 兼容协议，可独立配置 search model）
OPENAI_SEARCH_MODEL=gpt-4o-search-preview

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 竞品模糊匹配阈值（fuzzysort 分数，越小越宽松；-50 为默认）
FUZZY_MATCH_THRESHOLD=-50

# 监测目标平台凭证（示例，实际存于 workspace.platformConfig）
# 各 adapter 运行时从 workspace 读取

# ===== 平台安全基线（任务 12） =====

# 信封加密主密钥（AES-256-GCM，32 字节 hex）：加密 workspace.platformConfig 中的平台凭证。
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 丢失后已加密凭证无法解密；请安全备份，勿提交进仓库。
# ===== 【必改】=====
CREDENTIAL_MASTER_KEY=

# 允许跨域访问本服务的前端来源（逗号分隔，如 https://console.example.com,https://admin.example.com）。
# 留空 = 同源部署，不启用 CORS（推荐：反向代理同源挂载）。
CORS_ORIGINS=

# 会话 Cookie 名。默认 __Host- 前缀要求 Secure（HTTPS）+ 不带 Domain + Path=/，
# 浏览器会直接拒收非安全上下文下的 __Host- cookie，且不报错——表现为"登录后立刻掉线"。
#   localhost / 127.0.0.1：浏览器视为可信上下文，纯 http 本地部署没问题，保持默认。
#   裸 IP + 纯 http（如 http://203.0.113.10:5170）：必须改成非 __Host- 名，如 geo_sid。
#   HTTPS 部署（含演示站 demo.zoomer.top）：保持默认 __Host-geo_sid，保护更强，不要改。
GEO_COOKIE_NAME=__Host-geo_sid

# 平台员工（PLATFORM）会话空闲过期小时数，默认 8；客户用户固定 2 小时不可配。
SESSION_IDLE_PLATFORM_HOURS=8

# 计费强制执行开关（off/on）。**P2 计费体系已落地**（配额检查 / 服务状态矩阵 /
# 订阅到期只读均已生效）。off 时计费侧服务状态恒 ACTIVE、guard 全放行；
# 开启自助注册（REGISTRATION_ENABLED=on）时本项必须同时 on，否则注册通道 fail-closed。
BILLING_ENFORCEMENT=off

# 自助注册开关（off/on，M2 §3.0）。默认 off：公开注册会放脚本进来，误开风险高。
# **双开关联动**：本项与 BILLING_ENFORCEMENT 必须同时 on，自助注册才真正开启——
# 试用的配额与 TTL 全部挂在 entitlement 机器上，enforcement 关闭时开注册等于
# 放出无配额、无到期的无限租户。缺省关闭时 /register 显示关闭文案，登录页不显示入口。
# 开启后：访客注册即得 7 天试用租户（1 工作区 / 10 条查询软限 / 单次采样 N≤3），
# 到期进入只读保留（数据不删除），试用租户禁用 LLM 查询生成（平台 LLM 成本归零）。
REGISTRATION_ENABLED=off

# 订阅到期后的全局宽限天数（缺省 7）。仅对**未在订阅快照中声明 _graceDays** 的订阅生效；
# 自助试用快照自带 _graceDays=90，不受本项影响。
SUBSCRIPTION_GRACE_DAYS=7

# ===== 商业化 P2（任务 6） =====

# 在线支付 mock 渠道回调验签密钥（sha256(rawBody+secret)）。必填（fail-closed）：
# 缺失时服务启动即终止——默认密钥源码公开，静默回落等于可伪造支付回调签名。
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ===== 【必改】=====
PAY_MOCK_SECRET=

# ===== 商业化 P2（任务 14） =====

# 平台对公收款账户信息（JSON 字符串：户名/账号/开户行）。客户下单选"对公转账"时
# 在订单详情展示，转账备注请填订单号。留空或格式非法 = 前端显示"联系顾问获取收款信息"。
# 示例：PAYMENT_BANK_INFO={"accountName":"上海某某科技有限公司","accountNo":"3100123456789012","bankName":"中国银行上海分行"}
PAYMENT_BANK_INFO=

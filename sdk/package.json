{
  "name": "@geociteops/sdk",
  "version": "0.1.0",
  "description": "Typed tRPC client for the GeoCiteOps API — citation monitoring, content optimization, structured signals, and knowledge graph.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run typecheck"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/letheliu/geociteops.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/letheliu/geociteops/tree/main/sdk",
  "keywords": [
    "geo",
    "generative-engine-optimization",
    "llm-seo",
    "ai-search",
    "trpc",
    "sdk"
  ],
  "dependencies": {
    "@trpc/client": "^10.45.0",
    "@trpc/server": "^10.45.0"
  }
}

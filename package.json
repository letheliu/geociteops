{
  "name": "geociteops",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "pnpm --filter geociteops-web dev",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "admin:bootstrap": "tsx scripts/admin-bootstrap.ts",
    "gift:grant": "tsx scripts/grant-gift-subscriptions.ts",
    "demo:reset": "tsx scripts/reset-demo.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^5.18.0",
    "@trpc/server": "^10.45.0",
    "@zvec/zvec": "^0.5.0",
    "dotenv": "^16.4.0",
    "fastify": "^4.28.0",
    "fuzzysort": "^3.1.0",
    "pg-boss": "^10.1.0",
    "prisma": "^5.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
